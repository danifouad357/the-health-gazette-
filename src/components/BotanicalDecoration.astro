---
/*
 * =============================================================================
 * BOTANICAL DECORATION — The Health Gazette
 * =============================================================================
 * An ink-style botanical leaf illustration for the About page.
 * Uses inline SVG so it can inherit the --thg-color-ink or --thg-color-red.
 * =============================================================================
 */

interface Props {
  width?: number;
  height?: number;
  color?: string;
  className?: string;
}

const {
  width = 200,
  height = 200,
  color = 'var(--thg-color-ink-soft)',
  className = '',
} = Astro.props;
---

<svg 
  class={className} 
  width={width} 
  height={height} 
  viewBox="0 0 200 200" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- Stylized vintage branch/leaves pattern -->
  <path 
    d="M100 190 C 95 140, 80 100, 40 70 C 60 75, 80 90, 90 120 M 100 190 C 105 130, 130 90, 170 50 C 145 60, 120 85, 110 130 M 110 130 C 130 100, 160 80, 190 70 C 170 85, 140 110, 115 145 M 90 120 C 70 95, 40 80, 10 75 C 30 90, 55 110, 85 140 M 102 95 C 110 65, 120 40, 150 10 C 130 25, 115 50, 102 95 M 95 105 C 80 75, 60 45, 30 20 C 50 35, 70 65, 95 105" 
    stroke={color} 
    stroke-width="1.5" 
    stroke-linecap="round" 
    stroke-linejoin="round"
  />
  <circle cx="150" cy="10" r="3" fill={color} />
  <circle cx="30" cy="20" r="2.5" fill={color} />
  <circle cx="190" cy="70" r="2" fill={color} />
  <circle cx="10" cy="75" r="2" fill={color} />
</svg>

<style>
  svg {
    opacity: 0.8;
  }
</style>
