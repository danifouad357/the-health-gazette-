---
/*
 * =============================================================================
 * SECTION HEADING — The Health Gazette
 * =============================================================================
 * Newspaper-style section labels. Uppercase, tracked wide, with a
 * thick underline and red dot marker.
 *
 * Used to introduce major content sections on the page:
 *   "LATEST ISSUE" / "UPCOMING EVENTS" / "FROM THE GAZETTE"
 *
 * These are NOT <h1>-<h6> elements — they're visual section markers.
 * The actual heading hierarchy lives in the content below them.
 *
 * USAGE:
 *   <SectionHeading>Latest Issue</SectionHeading>
 *   <SectionHeading>Upcoming Events</SectionHeading>
 * =============================================================================
 */
---

<div class="section-heading">
  <slot />
</div>
