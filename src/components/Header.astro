---
/*
 * =============================================================================
 * HEADER — The Health Gazette
 * =============================================================================
 */

import EKGFlourish from './EKGFlourish.astro';
import ThemeToggle from './ThemeToggle.astro';
import { Image } from 'astro:assets';
import crassfLogo from '@/assets/images/logos/crassf-logo.png';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Articles', href: '/articles/' },
  { label: 'Issues', href: '/gazette/' },
  { label: 'Events', href: '/events/' },
  { label: 'About', href: '/about/' },
];

const currentPath = Astro.url.pathname;
import { sanityClient } from "sanity:client";
const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
---

<header class="site-header">
  {siteSettings?.announcementActive && siteSettings?.announcementText && (
    <div class="announcement-ribbon">
      <div class="container announcement-inner">
        <p>
          {siteSettings.announcementText}
          {siteSettings.announcementLink && (
            <a href={siteSettings.announcementLink} class="announcement-link">
              {siteSettings.announcementLinkLabel || 'Read more'} <span aria-hidden="true">→</span>
            </a>
          )}
        </p>
      </div>
    </div>
  )}
  <div class="masthead">
    <div class="container masthead-inner">
      <div class="masthead-left">
        <a href="/" class="masthead-logo-link" aria-label="Cancer Research & Awareness Student Scientific Forum">
          <Image
            src={crassfLogo}
            alt="Cancer Research & Awareness Student Scientific Forum"
            height={150}
            quality={95}
            class="masthead-logo"
          />
        </a>
      </div>
      <div class="masthead-center">
        <div class="masthead-title-row">
          <EKGFlourish width={140} stroke={1.2} />
          <a href="/" class="masthead-title-link">
            <h1 class="masthead-name"><span class="masthead-the">The</span> Health Gazette</h1>
          </a>
          <EKGFlourish width={140} stroke={1.2} />
        </div>
        <p class="masthead-subtitle">Student Scientific Editorial</p>
      </div>
      <div class="masthead-right">
        <div class="masthead-institution">
          <span>Cancer Research Institute</span>
          <span>Abu Dhabi University</span>
        </div>
        <div class="crest-placeholder" aria-label="Forum crest"><span>🛡</span></div>
      </div>
    </div>
  </div>

  <nav class="site-nav" aria-label="Main navigation">
    <div class="container nav-inner">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="nav-actions">
        <ThemeToggle />
        <a href="/submit/" class="btn btn-primary nav-submit">Submit <span aria-hidden="true">→</span></a>
        <button class="nav-search" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
        </button>
      </div>

      <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu-overlay" class="mobile-menu-overlay" aria-hidden="true">
    <div class="mobile-menu-inner">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/submit/" class="mobile-nav-link text-red">Submit an Article</a>
        </li>
      </ul>
      <div class="mobile-menu-footer">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle logic
  const btn = document.getElementById('mobile-menu-btn');
  const overlay = document.getElementById('mobile-menu-overlay');

  if (btn && overlay) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      overlay.setAttribute('aria-hidden', String(expanded));
      
      // Toggle a class on body to prevent scrolling
      document.body.style.overflow = expanded ? '' : 'hidden';
      
      // Animate hamburger to X
      if (expanded) {
        btn.classList.remove('menu-open');
      } else {
        btn.classList.add('menu-open');
      }
    });
  }
</script>

<style>
  /* ---- ANNOUNCEMENT RIBBON ---- */
  .announcement-ribbon {
    background-color: var(--thg-color-red);
    color: var(--thg-color-paper);
    padding-block: var(--thg-space-2);
    text-align: center;
    font-family: var(--thg-font-body);
    font-size: var(--thg-text-xs);
    font-weight: var(--thg-weight-bold);
    letter-spacing: var(--thg-tracking-wide);
    text-transform: uppercase;
  }
  .announcement-inner p {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--thg-space-3);
    flex-wrap: wrap;
  }
  .announcement-link {
    color: var(--thg-color-paper);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity var(--thg-transition-fast);
  }
  .announcement-link:hover {
    opacity: 0.8;
  }

  /* ---- MASTHEAD ---- */
  .masthead {
    background-color: var(--thg-color-warm);
    padding-block: var(--thg-space-5);
    border-bottom: var(--thg-rule-thin) solid var(--thg-color-line);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .masthead-left {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    max-width: 500px;
  }

  .masthead-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .masthead-logo {
    height: 132px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: opacity var(--thg-transition-fast), transform var(--thg-transition-fast);
  }

  .masthead-logo-link:hover .masthead-logo {
    opacity: 0.88;
    transform: scale(1.02);
  }

  :global([data-theme="dark"]) .masthead-logo {
    filter: invert(0.9) hue-rotate(180deg);
  }

  .masthead-center { text-align: center; flex: 1; }
  .masthead-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--thg-space-4);
  }

  .masthead-title-link { text-decoration: none; color: inherit; }
  .masthead-name {
    font-family: var(--thg-font-masthead-display);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: var(--thg-weight-black);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .masthead-name .masthead-the {
    font-family: var(--thg-font-masthead-script);
    font-weight: var(--thg-weight-regular);
    /* Was 0.55em — too small. Bumped to 0.78em so "The" reads as a real word, not a ghost. */
    font-size: 0.78em;
    letter-spacing: 0.02em;
    position: relative;
    top: 0.06em;
    margin-right: 0.12em;
  }

  .masthead-subtitle {
    font-family: var(--thg-font-body);
    font-size: var(--thg-text-xs);
    font-weight: var(--thg-weight-medium);
    letter-spacing: var(--thg-tracking-wider);
    text-transform: uppercase;
    color: var(--thg-color-muted);
    margin-top: var(--thg-space-1);
  }

  .masthead-right {
    display: flex;
    align-items: center;
    gap: var(--thg-space-3);
    flex-shrink: 0;
  }
  .masthead-institution {
    text-align: right;
    font-size: var(--thg-text-xs);
    color: var(--thg-color-muted);
    line-height: 1.4;
  }
  .masthead-institution span { display: block; }
  .crest-placeholder {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--thg-color-line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    overflow: hidden;
  }

  /* ---- NAVIGATION ---- */
  .site-nav {
    background-color: var(--thg-color-paper);
    border-bottom: var(--thg-rule-medium) solid var(--thg-color-ink);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--thg-space-3);
  }
  .nav-list { display: flex; gap: var(--thg-space-8); }
  .nav-link {
    font-family: var(--thg-font-body);
    font-size: var(--thg-text-sm);
    font-weight: var(--thg-weight-medium);
    letter-spacing: var(--thg-tracking-wide);
    text-decoration: none;
    color: var(--thg-color-ink);
    padding-block: var(--thg-space-2);
    position: relative;
    transition: color var(--thg-transition-fast);
  }
  .nav-link:hover { color: var(--thg-color-red); }
  .nav-link.active {
    color: var(--thg-color-ink);
    font-weight: var(--thg-weight-semibold);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--thg-color-red);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--thg-space-4);
  }
  .nav-submit { font-size: var(--thg-text-xs); padding: var(--thg-space-2) var(--thg-space-5); }
  .nav-search {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--thg-color-ink);
    padding: var(--thg-space-1);
    display: flex;
    transition: color var(--thg-transition-fast);
  }
  .nav-search:hover { color: var(--thg-color-red); }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--thg-space-2);
    z-index: 102;
    position: relative;
  }
  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--thg-color-ink);
    position: relative;
    transition: background 0.2s ease-out;
  }
  .hamburger::before, .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--thg-color-ink);
    transition: transform 0.2s ease-out, top 0.2s ease-out;
  }
  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  .mobile-menu-btn.menu-open .hamburger { background: transparent; }
  .mobile-menu-btn.menu-open .hamburger::before {
    transform: rotate(45deg);
    top: 0;
  }
  .mobile-menu-btn.menu-open .hamburger::after {
    transform: rotate(-45deg);
    top: 0;
  }

  /* Mobile overlay */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: var(--thg-color-paper);
    z-index: 101;
    transform: translateY(-100%);
    transition: transform 0.3s ease-in-out;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--thg-space-10);
  }
  .mobile-menu-overlay[aria-hidden="false"] {
    transform: translateY(0);
  }
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--thg-space-6);
    text-align: center;
  }
  .mobile-nav-link {
    font-family: var(--thg-font-display);
    font-size: var(--thg-text-2xl);
    font-weight: var(--thg-weight-bold);
    color: var(--thg-color-ink);
    text-decoration: none;
  }
  .text-red { color: var(--thg-color-red); }
  
  .mobile-menu-footer {
    margin-top: var(--thg-space-10);
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .masthead-left, .masthead-right { display: none; }
  }

  @media (max-width: 768px) {
    .nav-list, .nav-actions { display: none; }
    .mobile-menu-btn { display: block; }
    .masthead { padding-block: var(--thg-space-3); }
    .masthead-title-row :global(.ekg-flourish) { display: none; }
    .masthead-subtitle { font-size: 0.6rem; }
  }
</style>
